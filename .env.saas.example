# Copy to a private deployment environment file. Never commit actual secrets.
ROUTER_DOMAIN=router.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
ROUTER_SECRET_KEY=replace-with-a-generated-Fernet-key
OIDC_ISSUER=https://identity.example.com/realms/router
OIDC_CLIENT_ID=router
OIDC_CLIENT_SECRET=replace-with-the-identity-provider-client-secret
# Optional comma-separated hosts approved for custom HTTPS provider connections.
ROUTER_PROVIDER_HOSTS=
# Optional secret for an authenticated monitoring scraper. Empty disables metrics.
ROUTER_METRICS_TOKEN=
# Set 0 and recreate app containers to pause new generations/comparisons.
ROUTER_GENERATION_ENABLED=1
# Explicit proxy IP/CIDR only. Empty groups requests by direct peer IP.
# The proxy must overwrite X-Router-Client-IP and app ports must stay private.
ROUTER_TRUSTED_PROXY_CIDRS=
